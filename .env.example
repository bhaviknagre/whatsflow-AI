DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/whatsflow

REDIS_URL=redis://redis:6379

JWT_SECRET=CHANGE_ME

OPENAI_API_KEY=

META_APP_ID=

META_APP_SECRET=

META_GRAPH_API_VERSION=v23.0

META_WEBHOOK_VERIFY_TOKEN=

META_WEBHOOK_APP_SECRET=

ENCRYPTION_KEY=

MINIO_ENDPOINT=minio:9000

MINIO_ACCESS_KEY=minio

MINIO_SECRET_KEY=minio123

MINIO_BUCKET=whatsflow
# ============================================================
# Production
# ============================================================

APP_ENV=production
DEBUG=false

# Public frontend origin
CORS_ORIGINS=https://your-domain.com

# Authentication
JWT_SECRET=generate-a-random-32-plus-character-secret

# Fernet key generated with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=generate-fernet-key

# Disable API documentation in production unless explicitly needed
ENABLE_API_DOCS=false

# Database
POSTGRES_DB=whatsflow
POSTGRES_USER=whatsflow
POSTGRES_PASSWORD=generate-a-strong-password

# MinIO
MINIO_ROOT_USER=generate-minio-user
MINIO_ROOT_PASSWORD=generate-a-strong-password

# Meta credentials are intentionally configured during client/demo setup
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v23.0
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_REDIRECT_URI=
